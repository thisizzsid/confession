rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // User Profiles
    match /users/{userId} {
      // Allow anyone to read profiles (needed for Explore/Feed)
      allow read: if true;
      // Only owner can edit their profile
      allow write: if isOwner(userId);

      // User Subcollections (Notifications, Followers, Following)
      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow create: if isAuth(); // Allow others to trigger notifications
        allow update, delete: if isOwner(userId);
      }
      
      // Legacy/Secondary follower tracking used in Notifications page
      match /followers/{followerId} {
        allow read: if true;
        allow write: if isAuth(); // Needed for 'followBack' logic
      }
      match /following/{followingId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }
    }

    // Posts
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuth();
      // Only the post author can edit/delete their post
      // BUT allow anyone to update 'likes' and 'commentCount'
      allow update: if isAuth() && (
        resource.data.uid == request.auth.uid || 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'commentCount'])
      );
      allow delete: if isAuth() && resource.data.uid == request.auth.uid;

      // Comments Subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuth();
        // Owner can edit text; others can only vote
        allow update: if isAuth() && (
          resource.data.uid == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'downvotes'])
        );
        allow delete: if isAuth() && resource.data.uid == request.auth.uid;

        // Reports Subcollection
        match /reports/{reportId} {
          allow create: if isAuth();
          allow read: if false; // Private
        }
      }
    }

    // Follows (Root Collection)
    match /follows/{docId} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if isAuth() && resource.data.follower == request.auth.uid;
    }

    // Profile Views (for Dashboard stats)
    match /profileViews/{viewId} {
      allow read: if true;
      allow create: if isAuth();
    }

    // Private Chats
    match /chats/{chatId} {
      // Allow if user is part of the chat ID (format: uid1_uid2)
      allow read, write: if isAuth() && chatId.contains(request.auth.uid);
      
      match /messages/{messageId} {
        allow read, write: if isAuth() && chatId.contains(request.auth.uid);
      }
    }

    // WebRTC signaling metadata and ICE candidates. Media stays peer-to-peer.
    match /calls/{callId} {
      allow create: if isAuth() && (
        request.resource.data.callerId == request.auth.uid ||
        request.resource.data.calleeId == request.auth.uid
      );
      allow read: if isAuth() && (
        resource.data.callerId == request.auth.uid ||
        resource.data.calleeId == request.auth.uid
      );
      allow update: if isAuth() && (
        resource.data.callerId == request.auth.uid ||
        resource.data.calleeId == request.auth.uid
      ) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offer', 'answer', 'status']);

      match /callerCandidates/{candidateId} {
        allow read, write: if isAuth() && (
          get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid ||
          get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid
        );
      }

      match /calleeCandidates/{candidateId} {
        allow read, write: if isAuth() && (
          get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid ||
          get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid
        );
      }
    }

    // Deny unspecified collections by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
